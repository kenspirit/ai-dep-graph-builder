{
  "name": "ai-buddy",
  "displayName": "AI Buddy for pair programming",
  "description": "A simple VSCode extension with a right-click menu item",
  "version": "0.0.1",
  "publisher": "kenspirit",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.analyzeCodeDependency",
        "title": "Analyze code dependency"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.analyzeCodeDependency",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "AI Buddy",
      "properties": {
        "aiBuddy.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "MCP Server Path"
        },
        "aiBuddy.database.type": {
          "type": "string",
          "enum": [
            "ARCADEDB"
          ],
          "enumDescriptions": [
            "ArcadeDB"
          ],
          "default": "ARCADEDB",
          "description": "Database Type"
        },
        "aiBuddy.database.host": {
          "type": "string",
          "default": "",
          "description": "Database host"
        },
        "aiBuddy.database.port": {
          "type": "string",
          "default": "",
          "description": "Database port"
        },
        "aiBuddy.database.name": {
          "type": "string",
          "default": "",
          "description": "Database name"
        },
        "aiBuddy.database.user": {
          "type": "string",
          "default": "",
          "description": "Database user"
        },
        "aiBuddy.database.password": {
          "type": "string",
          "default": "",
          "description": "Database password"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "aiBuddy.code-dependency",
        "name": "code-dependency",
        "fullName": "Code Dependency",
        "isSticky": true,
        "commands": [
          {
            "name": "dependency",
            "description": "Obtain code dependency (upstream/downstream/all)"
          }
        ],
        "disambiguation": [
          {
            "category": "cat",
            "description": "The user wants to find change impact or dependent code components of selected Function.",
            "examples": [
              "What are impacted if I change this function?",
              "What changes are required if I made change like this?",
              "What is the call chain of this function?",
              "What functions are dependent on this?"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.8",
    "@types/vscode": "^1.94.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "axios": "^1.7.7"
  }
}
