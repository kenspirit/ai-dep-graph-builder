{
  "name": "ai-buddy",
  "displayName": "AI Buddy for pair programming",
  "description": "A simple VSCode extension with a right-click menu item",
  "version": "0.0.1",
  "publisher": "kenspirit",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.changeAndAffected",
        "title": "Advice Change and find Affected"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.changeAndAffected",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.8",
    "@types/vscode": "^1.94.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}
